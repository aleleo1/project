---
import { query_full } from "../db/mysql-adapter";
import Container from "./Container";
import { DEFAULT_INITIAL_STATE, Queries } from "../constants";
import { type ContainerData } from "../interfaces";
import {
  updateUrl,
  searchParamsToObject,
  getDeviceDetails,
  extractState
} from "../utils";
import Layout from "../layouts/Layout.astro";
import Download from "./Download.astro";
interface Props {
  download: number;
}
const mainUrl = new URL(Astro.request.url);
const userAgent = Astro.request.headers.get("user-agent")!;
const defaultWidth = getDeviceDetails(userAgent).isDesktop ? 1920 : 620;
const params = mainUrl.searchParams;
let state: URL = new URL(mainUrl);
let initialUrl = mainUrl.origin;

if ([...params].length > 0) {
  const normalState = { ...DEFAULT_INITIAL_STATE };
  normalState.q = Queries.normal;
  state =  updateUrl(mainUrl.origin, normalState);
} else {
  state = mainUrl
}

const s = searchParamsToObject(
  new URL(state).searchParams.toString(),
  DEFAULT_INITIAL_STATE

);
s.idx = DEFAULT_INITIAL_STATE.idx

s.action = DEFAULT_INITIAL_STATE.action;

const result = await query_full(s.date, s.q, s.rif, s.action, s.idx);
const container = { state: s, result };
initialUrl = updateUrl(mainUrl.origin, s).toString()
console.log(initialUrl, s.idx)
---

<Layout>
  <h1 class="flex justify-center font-extrabold text-xl">WIDV npm pkg Preview</h1>
  {!Astro.props.download && 
  (<span
    id="tmpUrl"
    data-value={initialUrl}
    class="absolute hidden z-100 top-0 left-0"></span>
  <script lang="javascript">
    window.history.pushState(
      {},
      "",
      document.getElementById("tmpUrl").getAttribute("data-value"),
    );
  </script>
  <Download />)}
  <div
    id="content-container"
    class="flex flex-col justify-center align-middle gap-y-2.5"
  >
        <div class="mb-20">
          <Container
            data={result}
            initialState={container.state}
            url={updateUrl(mainUrl.origin, container.state).toString()}
            dw={defaultWidth}
            tmpUrl={initialUrl}
            client:visible
            download={Astro.props.download}
          />
        </div>
  </div>
</Layout>
<style is:global>
  .invisible-clickable {
    fill: transparent;
  }
/*   .tooltip {
    opacity: 0;
    transition: opacity 0.3s;
  }
  .invisible-clickable:hover + .tooltip {
    opacity: 1;
  } */
  .tooltip-bg {
    fill: #333;
    rx: 4;
    ry: 4;
    cursor: pointer;
  }
  .tooltip-text {
    font-family: Arial, sans-serif;
    font-size: 12px;
    fill: white;
    cursor: pointer;
  }
